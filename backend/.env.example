# MongoDB Connection String
# Local MongoDB: mongodb://localhost:27017/mgnrega
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/mgnrega?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/mgnrega

# Server Port
PORT=5000

# Data.gov.in API Key (optional - for future API sync)
DATA_GOV_API_KEY=your_api_key_here

# Node Environment
NODE_ENV=development
